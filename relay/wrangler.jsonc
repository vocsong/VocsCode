{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "vocs-relay",
  "main": "src/entry.ts",
  "compatibility_date": "2026-01-15",
  // MCP SDK uses Node built-ins; verified locally only, this change does not deploy anything.
  "compatibility_flags": ["nodejs_compat"],
  // /app was the retired web remote client; the Worker answers it first with a redirect to
  // /dashboard, so a stale build left in public/app can never be served (docs/WEB-DASHBOARD.md).
  "assets": { "directory": "public", "run_worker_first": ["/app", "/app/*"] },
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }, { "name": "ENROLLMENTS", "class_name": "EnrollmentDirectory" }] },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Hub"] },
    { "tag": "v2", "new_sqlite_classes": ["EnrollmentDirectory"] }
  ],
  // CONTROL_MCP_ENABLED and CONTROL_DISCOVERY_ENABLED are deliberately unset.
  // Bind the named ControlDiscovery entrypoint only from the isolated MCP staging gateway.
  "vars": { "RELAY_ACCOUNT": "vocs-v1" },
  // The landing Worker must carry the same session-assertion secret. Disable the direct workers.dev
  // entry so browser pairing always passes through the GitHub gate at code.vocs.io.
  "workers_dev": false,
  // Edge rate limits (Workers Rate Limiting), checked in the Worker on every /v1 route before its
  // body is read or the Hub wakes (relay/src/edge.ts); the Hub keeps its own in-memory limits too.
  // Counters are per Cloudflare location and eventually consistent. Each namespace_id must be
  // unique within the Cloudflare account.
  "ratelimits": [
    { "name": "PAIR_LIMIT", "namespace_id": "4101", "simple": { "limit": 10, "period": 60 } },
    { "name": "POLL_LIMIT", "namespace_id": "4102", "simple": { "limit": 120, "period": 60 } },
    { "name": "TOKEN_LIMIT", "namespace_id": "4103", "simple": { "limit": 30, "period": 60 } },
    // Device routes: each device's own budget per route, and one total per address across all of
    // them, shared by every device behind it.
    { "name": "DEVICE_LIMIT", "namespace_id": "4104", "simple": { "limit": 300, "period": 60 } },
    { "name": "ADDRESS_LIMIT", "namespace_id": "4105", "simple": { "limit": 400, "period": 60 } }
  ]
  // Secrets: ENROLL_TOKEN, ACCOUNT_ASSERTION_SECRET (shared with landing), DEVICE_ROUTE_SECRET (stable relay-only key)
}
