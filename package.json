{
  "name": "vocs-code",
  "productName": "Vocs Code",
  "version": "0.1.0",
  "description": "Multi-harness, model-agnostic desktop app for coding agents: Claude Agent SDK, Codex, Pi, DeepSeek Harness, and a native loop.",
  "main": "./out/main/index.js",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Vocs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vocsong/Vocs-Code.git"
  },
  "homepage": "https://github.com/vocsong/Vocs-Code#readme",
  "bugs": {
    "url": "https://github.com/vocsong/Vocs-Code/issues"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "start": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run tests/branding.test.ts tests/pr.test.ts tests/unit.test.ts tests/format.test.ts tests/git-branch-state.test.ts tests/review-fixes.test.ts tests/terminal.test.ts tests/themes.test.ts tests/analytics.test.ts tests/composer-history.test.tsx tests/transcript-find.test.tsx",
    "dist:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "dist:dir": "electron-vite build && electron-builder --dir --config electron-builder.yml",
    "test:unit": "vitest run tests/branding.test.ts tests/pr.test.ts tests/unit.test.ts tests/format.test.ts tests/git-branch-state.test.ts tests/review-fixes.test.ts tests/terminal.test.ts tests/themes.test.ts tests/analytics.test.ts tests/composer-history.test.tsx",
    "test:e2e": "vitest run tests/e2e.electron.test.ts",
    "test:e2e:ui": "vitest run tests/e2e.vision.test.ts",
    "test:e2e:terminal": "vitest run tests/e2e.terminal.test.ts",
    "test:e2e:models": "vitest run tests/e2e.models.test.ts",
    "test:e2e:themes": "vitest run tests/e2e.themes.test.ts",
    "test:smoke": "vitest run tests/smoke.live.test.ts"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "@anthropic-ai/claude-agent-sdk": "^0.3.263",
    "@anthropic-ai/sdk": "^0.124.0",
    "@lydell/node-pty": "^1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@openai/codex-sdk": "^0.153.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "diff": "^9.0.0",
    "dompurify": "^3.4.15",
    "marked": "^18.0.11",
    "openai": "^7.10.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright-core": "^1.63.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  }
}
